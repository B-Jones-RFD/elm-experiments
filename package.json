{
  "name": "elm-experiments",
  "version": "0.1.0",
  "description": "A todo app exploring the Elm Architecture on Node / Hono / htmx",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/index.ts",
    "build": "tsc",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/otel": "^1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.1.1",
    "eslint": "^9.0.0",
    "htmx-ext-sse": "^2.2.0",
    "htmx.org": "^2.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
